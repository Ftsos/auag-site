# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------
# Posts are compiled in at build time from src/content/posts/ — there is no
# CMS URL to configure. This only controls how many events the Home page shows.
VITE_EVENTS_LIMIT=4

# ---------------------------------------------------------------------------
# Admin (/admin) — server-side only. Never prefix these with VITE_, or they
# would be baked into the public bundle.
# ---------------------------------------------------------------------------

# Password officers share to sign in. Generate a hash with:
#   npm run hash-password "your password"
# Prefer ADMIN_PASSWORD_HASH; plain ADMIN_PASSWORD works as a fallback.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# Random 32+ character string used to sign session cookies. Rotating it signs
# everyone out. Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=

# Fine-grained GitHub token with "Contents: Read and write" on the repo below.
# This is what lets officers publish without a GitHub account of their own.
GITHUB_TOKEN=
GITHUB_REPO=Ftsos/auag-site
GITHUB_BRANCH=main
